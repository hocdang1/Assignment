<%- include('../partials/header') %>

<h1>Comments</h1>
<ul>
  <% comments.forEach(function (comment) { %>
    <li>
      <%= comment.content %>
      <% if (comment.author) { %>
         — by <%= comment.author.name %>
      <% } %>
      <a href="/comments/<%= comment.id %>/user">Show user</a>
    </li>
  <% }); %>
</ul>

<%- include('../partials/footer') %>
