extends ../layout

block content
  h1 Users
  p: a(href='/users/create') + Create user
  table
    thead
      tr
        th ID
        th Name
        th Email
        th Age
        th Actions
    tbody
      each user in users
        tr
          td= user.id
          td: a(href=`/users/${user.id}/posts`)= user.name
          td= user.email
          td= user.age
          td
            a(href=`/users/${user.id}`) Show
            |
            a(href=`/users/${user.id}/comments`) Comments
