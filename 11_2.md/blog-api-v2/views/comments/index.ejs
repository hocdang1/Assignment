<%- include('../partials/header') %>

<p>
  <a href="/users">← Back to user list</a>
</p>

<% if (comments.length === 0) { %>
  <p class="empty">No comments yet.</p>
<% } else { %>
  <table>
    <thead>
      <tr>
        <th>ID</th>
        <th>Content</th>
        <th>Author</th>
        <th>On post</th>
      </tr>
    </thead>
    <tbody>
      <% comments.forEach(function (comment) { %>
        <tr>
          <td><%= comment.id %></td>
          <td><%= comment.content %></td>
          <td>
            <% if (comment.author) { %>
              <a href="/comments/<%= comment.id %>/user"><%= comment.author.name %></a>
              (<%= comment.author.email %>)
            <% } else { %>
              -
            <% } %>
          </td>
          <td>
            <% if (comment.post) { %>
              #<%= comment.post.id %> — <%= comment.post.content %>
            <% } else { %>
              -
            <% } %>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>
<% } %>

<%- include('../partials/footer') %>
