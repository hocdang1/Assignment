extends ../layout

block content
  if comments.length === 0
    p.empty No comments yet.
  else
    table
      thead
        tr
          th ID
          th Content
          th Author
          th Post
          th Actions
      tbody
        each comment in comments
          tr
            td= comment.id
            td= comment.content
            td= comment.author ? comment.author.name : '-'
            td= comment.post ? comment.post.content : '-'
            td
              a.btn(href=`/comments/${comment.id}/user`) Show user