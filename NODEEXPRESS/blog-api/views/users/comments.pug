extends ../layout

block content
  p
    a(href='/users') ← Back to user list
    |  |
    a(href=`/users/${user.id}`) User detail

  if comments.length === 0
    p.empty This user has no comments.
  else
    table
      thead
        tr
          th ID
          th Content
          th On post
      tbody
        each comment in comments
          tr
            td= comment.id
            td= comment.content
            td
              if comment.post
                = `#${comment.post.id} — ${comment.post.content}`
              else
                = '-'