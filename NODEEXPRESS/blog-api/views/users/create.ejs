<%- include('../partials/header') %>

<% if (errors && errors.length) { %>
  <ul class="errors">
    <% errors.forEach(function (err) { %>
      <li><%= err %></li>
    <% }); %>
  </ul>
<% } %>

<form method="POST" action="/users">
  <div>
    <label for="name">Name *</label>
    <input id="name" type="text" name="name" value="<%= old.name || '' %>" required>
  </div>
  <div>
    <label for="age">Age</label>
    <input id="age" type="number" name="age" value="<%= old.age || '' %>" min="0">
  </div>
  <div>
    <label for="email">Email *</label>
    <input id="email" type="email" name="email" value="<%= old.email || '' %>" required>
  </div>
  <div>
    <label for="password">Password *</label>
    <input id="password" type="password" name="password" required minlength="6">
  </div>
  <div>
    <label for="birthday">Birthday</label>
    <input id="birthday" type="date" name="birthday" value="<%= old.birthday || '' %>">
  </div>
  <div>
    <label for="status">Status</label>
    <select id="status" name="status">
      <option value="1" <%= String(old.status) !== '0' ? 'selected' : '' %>>Active</option>
      <option value="0" <%= String(old.status) === '0' ? 'selected' : '' %>>Inactive</option>
    </select>
  </div>
  <div>
    <button class="btn btn-primary" type="submit">Create</button>
    <a class="btn" href="/users">Cancel</a>
  </div>
</form>

<%- include('../partials/footer') %>
