<%- include('../partials/header') %>

<%
  function sortUrl(field) {
    const nextDir = (sort === field && dir === 'asc') ? 'desc' : 'asc';
    const params = new URLSearchParams();
    if (q) params.set('q', q);
    params.set('sort', field);
    params.set('dir', nextDir);
    return '/users?' + params.toString();
  }
  function pageUrl(p) {
    const params = new URLSearchParams();
    if (q) params.set('q', q);
    params.set('sort', sort);
    params.set('dir', dir);
    params.set('page', p);
    return '/users?' + params.toString();
  }
  function arrow(field) {
    if (sort !== field) return '';
    return dir === 'asc' ? ' ▲' : ' ▼';
  }
%>

<p>
  <button class="btn btn-primary" id="btnCreate" type="button">+ Create user</button>
</p>

<form class="search" method="GET" action="/users">
  <input type="text" name="q" placeholder="Search by name..." value="<%= q || '' %>">
  <input type="hidden" name="sort" value="<%= sort %>">
  <input type="hidden" name="dir" value="<%= dir %>">
  <button class="btn" type="submit">Search</button>
  <% if (q) { %>
    <a class="btn" href="/users">Clear</a>
  <% } %>
</form>

<% if (users.length === 0) { %>
  <p class="empty"><%= q ? `No users found for "${q}".` : 'No users yet.' %></p>
<% } else { %>
  <table>
    <thead>
      <tr>
        <th>ID</th>
        <th><a href="<%= sortUrl('name') %>">Name<%= arrow('name') %></a></th>
        <th><a href="<%= sortUrl('age') %>">Age<%= arrow('age') %></a></th>
        <th>Email</th>
        <th>Birthday</th>
        <th>Status</th>
        <th><a href="<%= sortUrl('postsCount') %>">Posts<%= arrow('postsCount') %></a></th>
        <th><a href="<%= sortUrl('commentsCount') %>">Comments<%= arrow('commentsCount') %></a></th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% users.forEach(function (user) { %>
        <tr>
          <td><%= user.id %></td>
          <td>
            <a href="/users/<%= user.id %>/posts" title="View posts"><%= user.name %></a>
          </td>
          <td><%= user.age %></td>
          <td><%= user.email %></td>
          <td><%= user.birthday ? user.birthday.toISOString().slice(0, 10) : '-' %></td>
          <td><%= user.status === 1 ? 'Active' : 'Inactive' %></td>
          <td>
            <a href="/users/<%= user.id %>/posts"><%= user.postsCount %></a>
          </td>
          <td>
            <a href="/users/<%= user.id %>/comments"><%= user.commentsCount %></a>
          </td>
          <td>
            <a class="btn" href="/users/<%= user.id %>">Show</a>
            <a class="btn" href="/users/<%= user.id %>/comments">Comments</a>
            <button
              class="icon-btn btn-edit"
              type="button"
              title="Edit user"
              data-id="<%= user.id %>"
              data-name="<%= user.name %>"
              data-age="<%= user.age === null ? '' : user.age %>"
              data-email="<%= user.email %>"
              data-birthday="<%= user.birthday ? user.birthday.toISOString().slice(0, 10) : '' %>"
              data-status="<%= user.status %>"
            >✏️</button>
            <button
              class="icon-btn btn-delete"
              type="button"
              title="Delete user"
              data-id="<%= user.id %>"
              data-name="<%= user.name %>"
            >🗑️</button>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>

  <% if (totalPages > 1) { %>
    <div class="pagination">
      <% if (page > 1) { %>
        <a class="btn" href="<%= pageUrl(page - 1) %>">← Prev</a>
      <% } %>
      <% for (let p = 1; p <= totalPages; p++) { %>
        <% if (p === page) { %>
          <span class="btn btn-primary"><%= p %></span>
        <% } else { %>
          <a class="btn" href="<%= pageUrl(p) %>"><%= p %></a>
        <% } %>
      <% } %>
      <% if (page < totalPages) { %>
        <a class="btn" href="<%= pageUrl(page + 1) %>">Next →</a>
      <% } %>
    </div>
  <% } %>

  <p class="meta">Showing page <%= page %> of <%= totalPages %> (<%= total %> users)</p>
<% } %>

<!-- ===== Create user modal ===== -->
<div class="modal-overlay" id="createModal" hidden>
  <div class="modal">
    <h2>Create user</h2>
    <div id="createErrors"></div>
    <form id="createForm">
      <div>
        <label for="c-name">Name *</label>
        <input id="c-name" type="text" name="name" required>
      </div>
      <div>
        <label for="c-age">Age</label>
        <input id="c-age" type="number" name="age" min="0">
      </div>
      <div>
        <label for="c-email">Email *</label>
        <input id="c-email" type="email" name="email" required>
      </div>
      <div>
        <label for="c-password">Password *</label>
        <input id="c-password" type="password" name="password" required minlength="6">
      </div>
      <div>
        <label for="c-birthday">Birthday</label>
        <input id="c-birthday" type="date" name="birthday">
      </div>
      <div>
        <label for="c-status">Status</label>
        <select id="c-status" name="status">
          <option value="1">Active</option>
          <option value="0">Inactive</option>
        </select>
      </div>
      <div class="modal-actions">
        <button class="btn btn-primary" type="submit">Save</button>
        <button class="btn" type="button" data-close="createModal">Cancel</button>
      </div>
    </form>
  </div>
</div>

<!-- ===== Edit user modal ===== -->
<div class="modal-overlay" id="editModal" hidden>
  <div class="modal">
    <h2>Edit user</h2>
    <div id="editErrors"></div>
    <form id="editForm">
      <input type="hidden" name="id">
      <div>
        <label for="e-name">Name *</label>
        <input id="e-name" type="text" name="name" required>
      </div>
      <div>
        <label for="e-age">Age</label>
        <input id="e-age" type="number" name="age" min="0">
      </div>
      <div>
        <label for="e-email">Email *</label>
        <input id="e-email" type="email" name="email" required>
      </div>
      <div>
        <label for="e-password">Password</label>
        <input id="e-password" type="password" name="password" minlength="6" placeholder="Leave blank to keep current password">
      </div>
      <div>
        <label for="e-birthday">Birthday</label>
        <input id="e-birthday" type="date" name="birthday">
      </div>
      <div>
        <label for="e-status">Status</label>
        <select id="e-status" name="status">
          <option value="1">Active</option>
          <option value="0">Inactive</option>
        </select>
      </div>
      <div class="modal-actions">
        <button class="btn btn-primary" type="submit">Save</button>
        <button class="btn" type="button" data-close="editModal">Cancel</button>
      </div>
    </form>
  </div>
</div>

<!-- ===== Delete confirmation modal ===== -->
<div class="modal-overlay" id="deleteModal" hidden>
  <div class="modal">
    <h2>Delete user</h2>
    <p id="deleteMessage"></p>
    <div class="modal-actions">
      <button class="btn btn-danger" id="deleteOkBtn" type="button">OK</button>
      <button class="btn" type="button" data-close="deleteModal">Cancel</button>
    </div>
  </div>
</div>

<script>
  (function () {
    function $(sel, ctx) { return (ctx || document).querySelector(sel); }

    function openModal(id) { $('#' + id).hidden = false; }
    function closeModal(id) { $('#' + id).hidden = true; }

    document.querySelectorAll('[data-close]').forEach(function (btn) {
      btn.addEventListener('click', function () { closeModal(btn.dataset.close); });
    });

    function showErrors(el, errors) {
      el.innerHTML = '';
      if (!errors || !errors.length) return;
      var ul = document.createElement('ul');
      ul.className = 'errors';
      errors.forEach(function (msg) {
        var li = document.createElement('li');
        li.textContent = msg;
        ul.appendChild(li);
      });
      el.appendChild(ul);
    }

    async function apiCall(url, method, body) {
      var res = await fetch(url, {
        method: method,
        headers: body ? { 'Content-Type': 'application/json' } : undefined,
        body: body ? JSON.stringify(body) : undefined,
      });
      var data = {};
      try { data = await res.json(); } catch (e) { /* no body */ }
      return { ok: res.ok, data: data };
    }

    // ----- Create -----
    var btnCreate = $('#btnCreate');
    var createForm = $('#createForm');
    var createErrors = $('#createErrors');

    btnCreate.addEventListener('click', function () {
      createForm.reset();
      showErrors(createErrors, []);
      openModal('createModal');
    });

    createForm.addEventListener('submit', async function (e) {
      e.preventDefault();
      var body = Object.fromEntries(new FormData(createForm).entries());
      var result = await apiCall('/api/users', 'POST', body);
      if (result.ok) {
        window.location.reload();
      } else {
        showErrors(createErrors, result.data.errors || ['Something went wrong.']);
      }
    });

    // ----- Edit -----
    var editForm = $('#editForm');
    var editErrors = $('#editErrors');

    document.querySelectorAll('.btn-edit').forEach(function (btn) {
      btn.addEventListener('click', function () {
        editForm.reset();
        showErrors(editErrors, []);
        editForm.elements.id.value = btn.dataset.id;
        editForm.elements.name.value = btn.dataset.name || '';
        editForm.elements.age.value = btn.dataset.age || '';
        editForm.elements.email.value = btn.dataset.email || '';
        editForm.elements.birthday.value = btn.dataset.birthday || '';
        editForm.elements.status.value = btn.dataset.status || '1';
        openModal('editModal');
      });
    });

    editForm.addEventListener('submit', async function (e) {
      e.preventDefault();
      var body = Object.fromEntries(new FormData(editForm).entries());
      var id = body.id;
      delete body.id;
      if (!body.password) delete body.password;
      var result = await apiCall('/api/users/' + id, 'PUT', body);
      if (result.ok) {
        window.location.reload();
      } else {
        showErrors(editErrors, result.data.errors || ['Something went wrong.']);
      }
    });

    // ----- Delete -----
    var deleteMessage = $('#deleteMessage');
    var deleteOkBtn = $('#deleteOkBtn');
    var pendingDeleteId = null;

    document.querySelectorAll('.btn-delete').forEach(function (btn) {
      btn.addEventListener('click', function () {
        pendingDeleteId = btn.dataset.id;
        deleteMessage.textContent = 'Are you sure you want to delete "' + btn.dataset.name + '"?';
        openModal('deleteModal');
      });
    });

    deleteOkBtn.addEventListener('click', async function () {
      if (!pendingDeleteId) return;
      var result = await apiCall('/api/users/' + pendingDeleteId, 'DELETE');
      if (result.ok) {
        window.location.reload();
      } else {
        closeModal('deleteModal');
        alert((result.data.errors || ['Something went wrong.']).join('\n'));
      }
    });
  })();
</script>

<%- include('../partials/footer') %>
