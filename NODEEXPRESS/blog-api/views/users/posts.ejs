<%- include('../partials/header') %>

<p>
  <a href="/users">← Back to user list</a>
  |
  <a href="/users/<%= user.id %>">User detail</a>
</p>

<% if (posts.length === 0) { %>
  <p class="empty">This user has no posts.</p>
<% } else { %>
  <table>
    <thead>
      <tr>
        <th>ID</th>
        <th>Content</th>
        <th>Created at</th>
      </tr>
    </thead>
    <tbody>
      <% posts.forEach(function (post) { %>
        <tr>
          <td><%= post.id %></td>
          <td><%= post.content %></td>
          <td><%= post.createdAt ? post.createdAt.toISOString().slice(0, 16).replace('T', ' ') : '-' %></td>
        </tr>
      <% }); %>
    </tbody>
  </table>
<% } %>

<%- include('../partials/footer') %>
