extends ../layout

block content
  if fromComment
    p.note This user wrote comment ##{fromComment.id}: "#{fromComment.content}"

  section
    h2 Information
    table.detail
      tr
        th ID
        td= user.id
      tr
        th Name
        td= user.name
      tr
        th Age
        td= user.age
      tr
        th Email
        td= user.email
      tr
        th Birthday
        td= fmtDate(user.birthday)
      tr
        th Status
        td= user.status === 1 ? 'Active' : 'Inactive'

  section
    h2 Profile
    if profile
      table.detail
        tr
          th Address
          td= profile.address
        tr
          th Tel
          td= profile.tel
        tr
          th Province
          td= profile.province
    else
      p.empty No profile.

  section
    h2 Posts (#{posts.length})
    if posts.length
      ul
        each post in posts
          li
            = post.content
            if post.comments && post.comments.length
              ul
                each c in post.comments
                  li= c.content
    else
      p.empty No posts.

  section
    h2 Comments (#{comments.length})
    if comments.length
      ul
        each comment in comments
          li
            = comment.content
            if comment.post
              small  (on post ##{comment.post.id})
    else
      p.empty No comments.

  p
    a(href='/users') ← Back to user list